@page
@model OLearn.Pages.Account.LoginModel
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c8161d" />
    <title>Sign in - iLearn Lite</title><link rel="stylesheet" href="/css/site.css" />
</head>
<body class="login">
    <section class="login-hero">
        <h2>iLearn Lite</h2>
        <svg class="login-art" viewBox="0 0 440 300" role="img" aria-label="A document saved on a laptop and a phone, protected by a time-limited lease">
            <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset="1" stop-color="#fff" stop-opacity=".08"/></linearGradient></defs>
            <ellipse cx="220" cy="270" rx="190" ry="14" fill="#000" opacity=".12"/>
            <!-- laptop -->
            <rect x="70" y="60" width="250" height="160" rx="8" fill="url(#g)" stroke="#fff" stroke-width="3"/>
            <rect x="82" y="72" width="226" height="136" rx="3" fill="#fff"/>
            <path d="M48 226h294l-14 22H62z" fill="#fff" opacity=".9"/>
            <rect x="96" y="86" width="86" height="12" rx="2" fill="#c8161d"/>
            <rect x="96" y="108" width="196" height="7" rx="2" fill="#e4e5ea"/>
            <rect x="96" y="124" width="170" height="7" rx="2" fill="#e4e5ea"/>
            <rect x="96" y="140" width="196" height="7" rx="2" fill="#e4e5ea"/>
            <rect x="96" y="156" width="120" height="7" rx="2" fill="#e4e5ea"/>
            <rect x="96" y="176" width="64" height="20" rx="3" fill="#c8161d"/>
            <path d="M108 186l5 5 9-9" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="168" y="180" width="60" height="12" rx="2" fill="#f7dede"/>
            <!-- phone -->
            <rect x="300" y="110" width="84" height="150" rx="12" fill="#fff" stroke="#fff"/>
            <rect x="308" y="124" width="68" height="120" rx="4" fill="#f3f3f5"/>
            <rect x="314" y="132" width="40" height="8" rx="2" fill="#c8161d"/>
            <rect x="314" y="148" width="56" height="30" rx="3" fill="#fff"/>
            <rect x="320" y="156" width="44" height="5" rx="2" fill="#e4e5ea"/>
            <rect x="320" y="166" width="30" height="5" rx="2" fill="#e4e5ea"/>
            <rect x="314" y="186" width="56" height="30" rx="3" fill="#fff"/>
            <rect x="320" y="194" width="44" height="5" rx="2" fill="#e4e5ea"/>
            <rect x="320" y="204" width="30" height="5" rx="2" fill="#e4e5ea"/>
            <rect x="340" y="116" width="24" height="3" rx="1.5" fill="#d0d2d8"/>
            <!-- lease clock badge -->
            <circle cx="338" cy="70" r="34" fill="#fff"/>
            <circle cx="338" cy="70" r="26" fill="none" stroke="#c8161d" stroke-width="4"/>
            <path d="M338 54v17l11 7" stroke="#c8161d" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- shield -->
            <path d="M96 20l32 12v26c0 20-14 34-32 40-18-6-32-20-32-40V32z" fill="#fff"/>
            <path d="M82 58l10 10 20-22" stroke="#c8161d" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- offline signal -->
            <g transform="translate(36 150)" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round"><path d="M0 14a22 22 0 0 1 36 0"/><path d="M8 24a12 12 0 0 1 20 0"/><circle cx="18" cy="33" r="2" fill="#fff"/><path d="M-4 -4L40 40" stroke-width="4"/></g>
        </svg>
        <p>Your approved course materials, available offline for as long as the University allows.</p>
    </section>
    <section class="login-form">
        <div class="login-box">
            <img class="logo" src="/img/isbat_logo.png" alt="ISBAT University" />
            <h1>Sign in</h1>
            <p class="muted">Sign in while connected. Your approved resources can then be saved for offline use.</p>
            @if (Model.Error != null) { <p class="error-text">@Model.Error</p> }
            <form method="post">
                <label class="field"><span>Username</span><input type="text" asp-for="Username" autocomplete="username" autofocus /></label>
                <label class="field"><span>Password</span><input type="password" asp-for="Password" autocomplete="current-password" /></label>
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="btn primary" type="submit">Sign in</button>
            </form>
        </div>
    </section>
</body>
</html>
